# localtok configuration — copy to .env and edit. ALL values are optional.
# Defaults are loopback addresses, so the tool works out of the box.

# Base URL of a local Ollama server.
LOCALTOK_OLLAMA_URL=http://127.0.0.1:11434

# Base URL of a generic OpenAI-compatible server
# (llama.cpp server, vLLM, LM Studio, LocalAI, ...).
LOCALTOK_OPENAI_URL=http://127.0.0.1:8000

# Bearer token for the OpenAI-compatible server, if it requires one.
# Most purely-local servers do NOT. Use a placeholder here; put the real
# value only in your private .env (which is git-ignored). Never commit a key.
LOCALTOK_OPENAI_API_KEY=replace-with-your-token-if-needed

# Refresh interval in seconds for the live dashboard.
LOCALTOK_INTERVAL=1.0
